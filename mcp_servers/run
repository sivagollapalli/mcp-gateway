#!/usr/bin/env bash
# Usage: mcp_servers/run orders|payments|all
set -e
cd "$(dirname "$0")"
case "$1" in
  orders)   exec PORT="${ORDERS_PORT:-9301}" bundle exec ruby orders/server.rb ;;
  payments) exec PORT="${PAYMENTS_PORT:-9302}" bundle exec ruby payments/server.rb ;;
  all)
    PORT="${ORDERS_PORT:-9301}" bundle exec ruby orders/server.rb &
    PORT="${PAYMENTS_PORT:-9302}" bundle exec ruby payments/server.rb &
    trap 'kill 0' INT TERM; wait ;;
  *) echo "usage: $0 orders|payments|all"; exit 1 ;;
esac
