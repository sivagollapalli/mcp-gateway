# OIDC (user-leg) authentication. Setting KEYCLOAK_ISSUER turns OIDC mode on for /mcp.
# Must match the realm's issuer byte for byte (no trailing slash).
KEYCLOAK_ISSUER=http://localhost:8080/realms/mcp
# Tokens must carry this value in `aud` (set by the realm's audience mapper).
GATEWAY_AUDIENCE=mcp-gateway
# Clock skew tolerance in seconds for exp/nbf.
CLOCK_LEEWAY=30
# Public base URL of this gateway (used in /.well-known/oauth-protected-resource).
GATEWAY_PUBLIC_URL=http://localhost:8081
# Optional: fetch discovery/JWKS through this base URL instead of the issuer host
# (set to http://keycloak:8080 when the gateway runs in the compose network).
# KEYCLOAK_INTERNAL_URL=
# Minimum seconds between JWKS refetches triggered by unknown kids.
# JWKS_MIN_REFETCH_INTERVAL=10
