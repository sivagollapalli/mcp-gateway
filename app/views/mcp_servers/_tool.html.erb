<% id = tool_dom_id(server, tool["name"]) %>
<li class="list-group-item" id="<%= id %>">
  <div class="d-flex justify-content-between align-items-start gap-3">
    <div class="flex-grow-1">
      <code class="fw-semibold"><%= ToolCatalog.encode_name(server.name, tool["name"]) %></code>
      <% unless enabled %><span class="badge text-bg-secondary ms-1">disabled</span><% end %>
      <div class="small text-secondary mt-1" style="white-space: pre-wrap;"><%= tool["description"] %></div>
      <a class="small" data-bs-toggle="collapse" href="#<%= id %>_schema" role="button" aria-expanded="false" aria-controls="<%= id %>_schema">Input schema</a>
      <div class="collapse mt-1" id="<%= id %>_schema"><pre class="bg-body-secondary p-2 rounded small mb-0"><%= JSON.pretty_generate(tool["inputSchema"] || {}) %></pre></div>
    </div>
    <%= button_to toggle_mcp_server_tool_policies_path(server, tool_name: tool["name"]), method: :patch, class: "btn btn-sm p-0 border-0" do %>
      <span class="form-check form-switch m-0 d-inline-block"><input class="form-check-input" type="checkbox" role="switch" <%= "checked" if enabled %> disabled aria-label="Toggle tool"></span>
    <% end %>
  </div>
</li>
