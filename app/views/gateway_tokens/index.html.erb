<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Gateway tokens</h1>
  <%= link_to "Create token", new_gateway_token_path, class: "btn btn-primary" %>
</div>
<div class="card shadow-sm"><div class="table-responsive">
  <table class="table align-middle mb-0">
    <thead><tr><th>Name</th><th>Created</th><th>Last used</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% @tokens.each do |t| %>
        <tr>
          <td><%= t.name %></td>
          <td><%= time_ago_or_dash(t.created_at) %></td>
          <td><%= time_ago_or_dash(t.last_used_at) %></td>
          <td><%= t.revoked? ? tag.span("revoked", class: "badge text-bg-secondary") : tag.span("active", class: "badge text-bg-success") %></td>
          <td class="text-end">
            <% unless t.revoked? %>
              <%= button_to "Revoke", revoke_gateway_token_path(t), method: :patch, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Revoke #{t.name}? Clients using it will stop working." } } %>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @tokens.empty? %><tr><td colspan="5" class="text-center text-secondary py-4">No tokens yet.</td></tr><% end %>
    </tbody>
  </table>
</div></div>
