<h1 class="h3 mb-3">Create gateway token</h1>
<div class="card shadow-sm"><div class="card-body">
  <%= form_with model: @token, url: gateway_tokens_path do |f| %>
    <% if @token.errors.any? %><div class="alert alert-danger"><%= @token.errors.full_messages.to_sentence %></div><% end %>
    <div class="mb-3">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, class: "form-control", required: true, maxlength: 100, placeholder: "e.g. Claude Code on my laptop" %>
    </div>
    <%= f.submit "Create token", class: "btn btn-primary" %>
    <%= link_to "Cancel", gateway_tokens_path, class: "btn btn-link" %>
  <% end %>
</div></div>
