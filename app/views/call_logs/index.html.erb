<h1 class="h3 mb-3">Call logs</h1>
<%= form_with url: call_logs_path, method: :get, class: "row g-2 mb-3" do |f| %>
  <div class="col-12 col-md-4">
    <%= f.select :server_id, options_from_collection_for_select(@servers, :id, :name, params[:server_id]), { include_blank: "All servers" }, class: "form-select", aria: { label: "Server" } %>
  </div>
  <div class="col-12 col-md-3">
    <%= f.select :status, options_for_select(CallLog::STATUSES, params[:status]), { include_blank: "Any status" }, class: "form-select", aria: { label: "Status" } %>
  </div>
  <div class="col-auto"><%= f.submit "Filter", class: "btn btn-outline-primary" %> <%= link_to "Reset", call_logs_path, class: "btn btn-link" %></div>
<% end %>
<div class="card shadow-sm"><div class="table-responsive">
  <table class="table table-sm align-middle mb-0">
    <thead><tr><th>Time</th><th>Server</th><th>Tool</th><th>Token</th><th>Status</th><th>Duration</th><th>Error</th></tr></thead>
    <tbody>
      <% @logs.each do |l| %>
        <tr>
          <td class="text-nowrap"><%= l.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
          <td><%= l.mcp_server&.name || "—" %></td>
          <td><code><%= l.tool_name %></code></td>
          <td><%= l.gateway_token&.name || "—" %></td>
          <td><%= status_badge(l.status) %></td>
          <td><%= l.duration_ms ? "#{l.duration_ms} ms" : "—" %></td>
          <td class="text-danger small"><%= truncate(l.error.to_s, length: 120) %></td>
        </tr>
      <% end %>
      <% if @logs.empty? %><tr><td colspan="7" class="text-center text-secondary py-4">No calls logged.</td></tr><% end %>
    </tbody>
  </table>
</div></div>
<% if @total_pages > 1 %>
  <nav class="mt-3" aria-label="Pagination"><ul class="pagination">
    <% (1..@total_pages).each do |p| %>
      <li class="page-item <%= 'active' if p == @page %>"><%= link_to p, call_logs_path(request.query_parameters.merge(page: p)), class: "page-link" %></li>
    <% end %>
  </ul></nav>
<% end %>
